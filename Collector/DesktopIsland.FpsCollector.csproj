<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
  <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><PlatformTarget>x64</PlatformTarget>
  <AssemblyName>DesktopIsland.FpsCollector</AssemblyName><Version>1.3.0</Version>
  <DebugType>none</DebugType><DebugSymbols>false</DebugSymbols><Deterministic>true</Deterministic>
  <PathMap>$(MSBuildProjectDirectory)=/_/DesktopIsland/Collector</PathMap>
  <Description>DesktopIsland external frame event collector</Description>
 </PropertyGroup>
 <ItemGroup>
  <Compile Include="..\Shared\FpsProtocol.cs" Link="FpsProtocol.cs"/>
  <Compile Include="..\Core\DxgiFrameCounter.cs" Link="DxgiFrameCounter.cs"/>
  <Compile Include="..\Core\FrameWindow.cs" Link="FrameWindow.cs"/>
  <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.21"/>
  <None Include="..\licenses\TraceEvent-MIT.txt" Link="licenses\TraceEvent-MIT.txt" CopyToOutputDirectory="PreserveNewest"/>
 </ItemGroup>
</Project>
